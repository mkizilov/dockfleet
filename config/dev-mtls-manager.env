# Overlay sourced after dev.env by `make run-manager-mtls`. Credentials come
# from `make dev-pki` (directory .dev-pki, git-ignored; never commit keys).
# With TLS the admin API serves HTTPS and the agent listener requires client
# certificates signed by the CA below. DOCKFLEET_AGENT_TOKEN is then ignored.

DOCKFLEET_TLS_CERT_FILE=.dev-pki/manager.pem
DOCKFLEET_TLS_KEY_FILE=.dev-pki/manager.key
DOCKFLEET_TLS_CLIENT_CA_FILE=.dev-pki/ca.pem
