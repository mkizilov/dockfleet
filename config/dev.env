# Development-only configuration, shared by `make run-*`, `make test-integration`
# and Docker Compose. Every value here is a throwaway; never reuse these
# credentials outside a local workstation. Plain KEY=value lines (shell-sourceable).

DOCKFLEET_LOG_LEVEL=debug
DOCKFLEET_LOG_FORMAT=text

# Manager
DOCKFLEET_API_ADDR=127.0.0.1:21280
DOCKFLEET_GRPC_ADDR=127.0.0.1:21281
DOCKFLEET_API_TOKEN=dev-api-token-0123456789
DOCKFLEET_AGENT_TOKEN=dev-agent-token-0123456789
DOCKFLEET_STORE=postgres
DOCKFLEET_DATABASE_URL=postgres://dockfleet:dockfleet-dev@127.0.0.1:21232/dockfleet?sslmode=disable

# Agent. Nodes must be enrolled before they can register: `make dev-enroll`.
# For mutual TLS see dev-mtls-manager.env / dev-mtls-agent.env.
DOCKFLEET_MANAGER_ADDR=127.0.0.1:21281
DOCKFLEET_NODE_ID=dev-node-1
DOCKFLEET_NODE_LABELS=env=dev
# Rootless Docker and Colima use other socket paths; adjust if needed.
DOCKFLEET_DOCKER_HOST=unix:///var/run/docker.sock

# Docker Compose (PostgreSQL)
POSTGRES_USER=dockfleet
POSTGRES_PASSWORD=dockfleet-dev
POSTGRES_DB=dockfleet
DOCKFLEET_POSTGRES_PORT=21232
