# Overlay sourced after dev.env by `make run-agent-mtls`. The certificate must
# be issued for DOCKFLEET_NODE_ID (dev-node-1 in dev.env) and the node must be
# enrolled (`make dev-enroll SCHEME=https`). Credentials come from `make dev-pki`.

DOCKFLEET_TLS_CA_FILE=.dev-pki/ca.pem
DOCKFLEET_TLS_CERT_FILE=.dev-pki/agents/dev-node-1/agent.pem
DOCKFLEET_TLS_KEY_FILE=.dev-pki/agents/dev-node-1/agent.key
DOCKFLEET_TLS_SERVER_NAME=localhost
