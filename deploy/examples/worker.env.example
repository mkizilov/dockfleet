# DockFleet agent (worker node): example configuration, no secrets.
# Copy to /etc/dockfleet/worker.env (mode 0640, group dockfleet) and edit.
# The node's private key stays on the node: create it with
#   dockfleet-pki new-csr -node-id worker-1 -out /etc/dockfleet/tls
# and have the CA host sign only the request. See docs/credentials.md.

# ---- identity --------------------------------------------------------------
# Must equal the node ID in the certificate; the agent refuses to start otherwise.
DOCKFLEET_NODE_ID=worker-1
DOCKFLEET_NODE_NAME=worker-1
# Labels that services select nodes by (node_selector).
DOCKFLEET_NODE_LABELS=zone=a,tier=general

# ---- capacity (declared, not measured) ---------------------------------------
DOCKFLEET_NODE_CPU_MILLIS=4000
DOCKFLEET_NODE_MEMORY_MB=8192

# ---- the managers ------------------------------------------------------------
# One address, or every manager of a high-availability cluster: only the leader
# answers and the agent finds it.
DOCKFLEET_MANAGER_ADDRS=manager-1.internal:21281,manager-2.internal:21281
DOCKFLEET_TLS_CA_FILE=/etc/dockfleet/tls/ca.pem
DOCKFLEET_TLS_CERT_FILE=/etc/dockfleet/tls/agent.pem
DOCKFLEET_TLS_KEY_FILE=/etc/dockfleet/tls/agent.key

# ---- the container engine -----------------------------------------------------
DOCKFLEET_DOCKER_HOST=unix:///var/run/docker.sock

# ---- behaviour ----------------------------------------------------------------
# Stop this node's containers when the manager's lease on it runs out, so that
# the replacements the manager starts elsewhere are not also running here.
DOCKFLEET_FENCE_ON_LEASE_LOSS=true
DOCKFLEET_RPC_TIMEOUT=5s
# Loopback only; the image's HEALTHCHECK and your monitoring ask /healthz and /readyz.
DOCKFLEET_HEALTH_ADDR=127.0.0.1:21282
# How many log requests the agent serves at once for the manager; 0 turns it off.
DOCKFLEET_LOG_MAX_REQUESTS=16
DOCKFLEET_LOG_LEVEL=info
DOCKFLEET_LOG_FORMAT=json

# ---- container policy: the defaults are the strictest; relax only on purpose ---
# Host directories containers may bind-mount (never /, /etc, /var/run, ...):
#DOCKFLEET_ALLOWED_BIND_ROOTS=/srv/data
# Capabilities containers may add (dangerous ones are always refused):
#DOCKFLEET_ALLOWED_CAPABILITIES=NET_BIND_SERVICE
