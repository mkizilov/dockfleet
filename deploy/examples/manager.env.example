# DockFleet manager: example configuration, one line per setting, no secrets.
# Copy to /etc/dockfleet/manager.env (mode 0640, group dockfleet) and edit.
#
# Credentials are NOT set here. They are files, named by the *_FILE variables
# below, so that they never appear in the process environment, in `docker
# inspect`, in `ps e` or in a crash report. See docs/credentials.md.

# ---- identity -------------------------------------------------------------
# Unique per manager. Required when several managers share a database.
DOCKFLEET_INSTANCE_ID=manager-1

# ---- listeners (TLS is mandatory for anything but loopback) ----------------
DOCKFLEET_API_ADDR=0.0.0.0:21280
DOCKFLEET_GRPC_ADDR=0.0.0.0:21281
DOCKFLEET_TLS_CERT_FILE=/etc/dockfleet/tls/manager.pem
DOCKFLEET_TLS_KEY_FILE=/etc/dockfleet/tls/manager.key
DOCKFLEET_TLS_CLIENT_CA_FILE=/etc/dockfleet/tls/ca.pem

# ---- credentials (files, one value each) -------------------------------------
# Compose and Docker secrets mount files at /run/secrets, as below. Under systemd
# remove these two lines: the unit points them at its credentials directory.
DOCKFLEET_API_TOKEN_FILE=/run/secrets/dockfleet_api_token
DOCKFLEET_DATABASE_URL_FILE=/run/secrets/dockfleet_database_url

# ---- state ------------------------------------------------------------------
DOCKFLEET_STORE=postgres

# ---- node failure handling (defaults shown) ----------------------------------
# A node is suspect after NODE_TTL of silence, its agent stops its own containers
# when NODE_LEASE runs out, and its replicas are started elsewhere after
# NODE_UNAVAILABLE_AFTER. UNAVAILABLE_AFTER must be at least LEASE + HEARTBEAT.
DOCKFLEET_HEARTBEAT_INTERVAL=10s
DOCKFLEET_NODE_TTL=30s
DOCKFLEET_NODE_LEASE=1m
DOCKFLEET_NODE_UNAVAILABLE_AFTER=2m

# ---- loops ---------------------------------------------------------------------
DOCKFLEET_SCHEDULER_INTERVAL=5s
DOCKFLEET_RECONCILE_INTERVAL=5s
# 1 = never promise a node more CPU/memory than it has.
DOCKFLEET_SCHEDULER_CPU_OVERCOMMIT=1
DOCKFLEET_SCHEDULER_MEMORY_OVERCOMMIT=1

# ---- operation ------------------------------------------------------------------
DOCKFLEET_LOG_LEVEL=info
DOCKFLEET_LOG_FORMAT=json
DOCKFLEET_REQUEST_TIMEOUT=10s
DOCKFLEET_SHUTDOWN_TIMEOUT=15s
DOCKFLEET_METRICS_ENABLED=true
DOCKFLEET_DASHBOARD_ENABLED=true

# ---- high availability: uncomment on every manager of a cluster ---------------
# Several managers share the database and elect one leader through etcd. Needs
# DOCKFLEET_STORE=postgres and a unique DOCKFLEET_INSTANCE_ID per manager.
# DOCKFLEET_NODE_LEASE must be at least 2 x DOCKFLEET_ELECTION_TTL + the heartbeat.
#DOCKFLEET_ETCD_ENDPOINTS=https://etcd-1.internal:2379,https://etcd-2.internal:2379,https://etcd-3.internal:2379
#DOCKFLEET_ETCD_CA_FILE=/etc/dockfleet/tls/etcd-ca.pem
#DOCKFLEET_ETCD_CERT_FILE=/etc/dockfleet/tls/etcd-client.pem
#DOCKFLEET_ETCD_KEY_FILE=/etc/dockfleet/tls/etcd-client.key
#DOCKFLEET_ETCD_PREFIX=/dockfleet
#DOCKFLEET_ELECTION_TTL=15s
